{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jemather/dfeols/main/src/dfeols/schema/profiles/inference-0.1.json",
  "title": "inference/0.1",
  "description": "Profile for records with classical inference (R lm/estimatr, statsmodels, Stata regress). Requires, on top of the core: estimate, std_error and p_value on every row that isn't dropped; metrics.nobs and df_residual; a default vcov (the one marked default, or the only one) with type and ssc.convention.",
  "allOf": [
    {"$ref": "../estimation-0.1.json"},
    {"$ref": "#/$defs/rules"}
  ],
  "$defs": {
    "rules": {
      "type": "object",
      "required": ["metrics", "structures"],
      "properties": {
        "parameters": {
          "items": {
            "if": {"required": ["dropped"], "properties": {"dropped": {"type": "string"}}},
            "else": {"required": ["estimate", "std_error", "p_value"]}
          }
        },
        "metrics": {"required": ["nobs", "df_residual"]},
        "structures": {
          "required": ["vcov"],
          "properties": {
            "vcov": {
              "description": "At most one vcov is the default; the default (or a lone vcov) needs type and ssc with at least convention.",
              "contains": {"properties": {"default": {"const": true}}, "required": ["default"]},
              "minContains": 0,
              "maxContains": 1,
              "anyOf": [
                {"contains": {"$ref": "#/$defs/default_vcov"}},
                {"maxItems": 1, "items": {"$ref": "#/$defs/complete_vcov"}}
              ]
            }
          }
        }
      }
    },
    "complete_vcov": {
      "required": ["type", "ssc"],
      "properties": {"ssc": {"required": ["convention"]}}
    },
    "default_vcov": {
      "allOf": [{"$ref": "#/$defs/complete_vcov"}],
      "required": ["default"],
      "properties": {"default": {"const": true}}
    }
  }
}
