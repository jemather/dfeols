{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jemather/dfeols/main/src/dfeols/schema/estimation-0.1.json",
  "title": "estimation/0.1",
  "x-license": "CC0-1.0",
  "description": "One estimation run: what was estimated, what came out, and how and where it ran. Specification: docs/design/estimation-format.md. Absent key = not recorded by this producer; null = applies but wasn't computed. Non-finite numbers are the strings \"NaN\", \"Inf\", \"-Inf\". Times are UTC, ISO 8601. Fields marked \"x-identifying\": true identify people, hosts, paths or jobs; none is required and a redactor removes or hashes them. \"x-expected\" lists keys a validator warns about when absent; \"x-vocabulary\" lists recommended values of an open string field.",
  "type": "object",
  "required": ["schema", "meta", "parameters"],
  "x-expected": ["metrics", "specification", "provenance"],
  "x-size-limits": {
    "warn_bytes": 1000000,
    "warn_elements": 10000,
    "fail_bytes": 16000000,
    "description": "Checked by validators, not expressible in JSON Schema. Elements count the items of one array, nested arrays by their leaves. Per-observation and per-level output must be an attachment."
  },
  "properties": {
    "schema": {"const": "estimation/0.1"},
    "meta": {"$ref": "#/$defs/meta"},
    "parameters": {
      "description": "The model's reported parameters, one row per term (per response/component). Per-level estimates (FE coefficients, BLUPs) are not parameters: they go in an attachment.",
      "type": "array",
      "items": {"$ref": "#/$defs/parameter"}
    },
    "metrics": {"$ref": "#/$defs/metrics"},
    "specification": {"$ref": "#/$defs/specification"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "structures": {"$ref": "#/$defs/structures"},
    "publication": {"$ref": "#/$defs/publication"},
    "validation": {"$ref": "#/$defs/validation"},
    "attachments": {
      "type": "array",
      "items": {"$ref": "#/$defs/attachment"}
    },
    "extensions": {
      "description": "Blocks added by tools, one per namespace. A tool adds or replaces only its own block. The core schema doesn't validate block content; the block's `schema` names the schema that does.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/extension"}
    },
    "history": {
      "description": "Every tool that created, extended, validated or redacted the record, in order.",
      "type": "array",
      "items": {"$ref": "#/$defs/history_entry"}
    }
  },
  "$defs": {
    "number": {
      "description": "A JSON number, or a non-finite value as a string.",
      "anyOf": [{"type": "number"}, {"enum": ["NaN", "Inf", "-Inf"]}]
    },
    "number_or_null": {"anyOf": [{"$ref": "#/$defs/number"}, {"type": "null"}]},
    "count": {"type": "integer", "minimum": 0},
    "timestamp": {
      "description": "ISO 8601 date-time in UTC.",
      "type": "string",
      "format": "date-time"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "redacted": {
      "description": "A value replaced by `estimation redact --hash`: HMAC-SHA256 with the redactor's salt, so values hashed with the same salt still compare equal. The history entry's `salt_id` names the salt.",
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "strings": {"type": "array", "items": {"type": "string"}},
    "tool": {
      "description": "A piece of software, by name and version.",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[0-9]+(\\.[0-9]+)*$"},

    "meta": {
      "type": "object",
      "required": ["id", "created", "status"],
      "properties": {
        "id": {"description": "UUID of this record.", "type": "string", "format": "uuid"},
        "parent": {"description": "id of the record this one derives from (same model, new vcov).", "type": "string"},
        "created": {"$ref": "#/$defs/timestamp"},
        "status": {
          "description": "A failed run still writes what it knows.",
          "enum": ["ok", "warning", "failed"]
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "message"],
            "properties": {
              "level": {"type": "string", "x-vocabulary": ["info", "warning", "error"]},
              "code": {"type": "string"},
              "message": {"type": "string"},
              "source": {"type": "string"}
            }
          }
        },
        "estimator": {
          "description": "{family, method, ...}; any string is valid, the vocabulary is recommended.",
          "type": "object",
          "properties": {
            "family": {"type": "string", "x-vocabulary": ["linear", "glm", "mixed", "ensemble", "tree", "kernel", "neural", "other"]},
            "method": {"type": "string", "x-vocabulary": ["ols", "wls", "2sls", "liml", "gmm", "cue", "kclass", "fuller", "mle", "qmle", "random_forest", "gradient_boosting"]},
            "distribution": {"type": "string"},
            "link": {"type": "string"}
          }
        },
        "responses": {"$ref": "#/$defs/strings"},
        "profiles": {
          "description": "Profiles this record claims to follow, e.g. [\"linear-fe/0.1\", \"dfeols/0.1\"].",
          "type": "array",
          "items": {"$ref": "#/$defs/profile_id"}
        },
        "title": {"type": "string"},
        "tags": {"$ref": "#/$defs/strings"},
        "notes": {"type": "string"},
        "producer": {
          "description": "The code that wrote the record, when it isn't the estimating software (e.g. a converter that reads Stata e()).",
          "$ref": "#/$defs/tool"
        },
        "core_digest": {
          "description": "sha256 over the canonical form (RFC 8785) of meta (without core_digest), specification, metrics, parameters and structures, as written. Optional; writers include it by default.",
          "type": "object",
          "required": ["algorithm", "canonicalization", "value"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "canonicalization": {"const": "RFC8785"},
            "value": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },

    "parameter": {
      "type": "object",
      "required": ["term"],
      "properties": {
        "term": {"description": "The name exactly as the producing software reports it.", "type": "string"},
        "canonical": {"$ref": "#/$defs/canonical_term"},
        "estimate": {"$ref": "#/$defs/number_or_null"},
        "std_error": {"$ref": "#/$defs/number_or_null"},
        "statistic": {"$ref": "#/$defs/number_or_null"},
        "p_value": {"$ref": "#/$defs/number_or_null"},
        "conf_low": {"$ref": "#/$defs/number_or_null"},
        "conf_high": {"$ref": "#/$defs/number_or_null"},
        "response": {"description": "Which outcome, in multi-response models.", "type": "string"},
        "component": {"type": "string", "x-vocabulary": ["first_stage", "zero_inflation", "random", "conditional"]},
        "group": {"description": "Grouping factor of a random-effect term.", "type": "string"},
        "dropped": {
          "description": "Kept as rows so the term list is complete.",
          "enum": [null, "collinear", "reference"]
        },
        "importance": {"$ref": "#/$defs/number_or_null"},
        "rank": {"type": "integer"}
      }
    },
    "canonical_term": {
      "description": "Standard form for matching across tools. `factors` is the definition; `name` is an R-style rendering (Stata form for factor x continuous). Matching on factors is order-insensitive.",
      "type": "object",
      "required": ["name", "factors"],
      "properties": {
        "name": {"type": "string"},
        "factors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["variable"],
            "properties": {
              "variable": {"type": "string"},
              "level": {"type": ["string", "number", "boolean"]},
              "reference": {"type": ["string", "number", "boolean"]},
              "level_label": {"type": "string"},
              "transform": {"type": "string"}
            }
          }
        }
      }
    },

    "metric": {
      "description": "A scalar, or {value, definition, ...} to say exactly what was computed.",
      "anyOf": [
        {"$ref": "#/$defs/number"},
        {"type": ["string", "boolean", "null"]},
        {
          "type": "object",
          "required": ["value"],
          "properties": {
            "value": {"anyOf": [{"$ref": "#/$defs/number"}, {"type": ["string", "boolean", "null"]}]},
            "definition": {"type": "string"}
          }
        }
      ]
    },
    "count_metric": {
      "anyOf": [
        {"$ref": "#/$defs/count"},
        {"type": "null"},
        {"type": "object", "required": ["value"], "properties": {"value": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]}}}
      ]
    },
    "metrics": {
      "description": "Flat dict of named scalars. Names follow broom glance where one exists; the registered names below have fixed meanings, and unregistered names are allowed. Profiles register more.",
      "type": "object",
      "properties": {
        "nobs": {"description": "Rows used in estimation.", "$ref": "#/$defs/count_metric"},
        "df_residual": {"description": "Residual degrees of freedom as the tool reports it, normally N - K - absorbed levels; use {value, definition} when the tool's value means something else (e.g. min(G) - 1 under clustering). The df used for t tests goes in structures.vcov[].df_t.", "$ref": "#/$defs/metric"},
        "df_model": {"description": "Model degrees of freedom.", "$ref": "#/$defs/metric"},
        "conf_level": {"description": "Level of conf_low/conf_high in parameters.", "$ref": "#/$defs/metric"},
        "r2": {"$ref": "#/$defs/metric"},
        "adj_r2": {"$ref": "#/$defs/metric"},
        "sigma": {"description": "Residual standard error (RMSE).", "$ref": "#/$defs/metric"},
        "log_lik": {"$ref": "#/$defs/metric"},
        "aic": {"$ref": "#/$defs/metric"},
        "bic": {"$ref": "#/$defs/metric"},
        "deviance": {"$ref": "#/$defs/metric"},
        "f_stat": {"description": "Joint test of the regressors.", "$ref": "#/$defs/metric"},
        "mse": {"$ref": "#/$defs/metric"},
        "auc": {"$ref": "#/$defs/metric"}
      },
      "additionalProperties": {"$ref": "#/$defs/metric"}
    },

    "specification": {
      "description": "What was asked for, in the estimating software's own terms, fully resolved (defaults included).",
      "type": "object",
      "properties": {
        "call": {"description": "The command as written.", "type": "string"},
        "formula": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {"type": "string"},
            "syntax": {"type": "string", "x-vocabulary": ["R", "fixest", "patsy", "formulaic", "stata", "julia"]}
          }
        },
        "terms": {"description": "Expanded regressors in model order.", "$ref": "#/$defs/strings"},
        "factor_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["variable"],
            "properties": {
              "variable": {"type": "string"},
              "levels": {"type": "array"},
              "reference": {"type": ["string", "number", "boolean", "null"]}
            }
          }
        },
        "weights": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["variable"],
              "properties": {
                "variable": {"type": "string"},
                "type": {"type": "string", "x-vocabulary": ["analytic", "frequency", "probability", "importance"]}
              }
            }
          ]
        },
        "fixed_effects": {"description": "As specified (names, interactions, slopes).", "type": "array"},
        "endogenous": {"$ref": "#/$defs/strings"},
        "instruments": {"$ref": "#/$defs/strings"},
        "clusters": {"$ref": "#/$defs/strings"},
        "sample": {
          "type": "object",
          "properties": {
            "restriction": {"description": "The restriction as written.", "type": ["string", "null"]},
            "rows_input": {"description": "Rows in the data before any removal (fixest nobs_origin).", "$ref": "#/$defs/count"},
            "dropped": {
              "description": "Rows dropped, by reason.",
              "type": "object",
              "properties": {
                "missing": {
                  "description": "Total, or per variable.",
                  "anyOf": [{"$ref": "#/$defs/count"}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}}]
                },
                "singletons": {"$ref": "#/$defs/count"},
                "zero_weights": {"$ref": "#/$defs/count"},
                "other": {"$ref": "#/$defs/count"}
              },
              "additionalProperties": {"$ref": "#/$defs/count"}
            }
          }
        },
        "state": {
          "description": "Settings in force from outside the call that change results: active filter/weight/split (SPSS), xtset, if/in, set seed (Stata), options() (R), missing-value codes.",
          "type": "object"
        },
        "options": {
          "description": "Every option with its effective value. Profiles register names.",
          "type": "object"
        }
      }
    },

    "structure": {
      "description": "A named complex object with a kind, decodable without knowing the estimator.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["matrix", "table", "tree", "series", "object", "link"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "matrix"}}, "required": ["kind"]},
          "then": {
            "required": ["data"],
            "properties": {
              "data": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/number_or_null"}}},
              "labels": {"$ref": "#/$defs/strings"},
              "row_labels": {"$ref": "#/$defs/strings"},
              "col_labels": {"$ref": "#/$defs/strings"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "table"}}, "required": ["kind"]},
          "then": {
            "required": ["columns", "rows"],
            "properties": {
              "columns": {"$ref": "#/$defs/strings"},
              "rows": {"type": "array", "items": {"type": "array"}}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "series"}}, "required": ["kind"]},
          "then": {"required": ["data"], "properties": {"data": {"type": "array"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "link"}}, "required": ["kind"]},
          "then": {
            "description": "The structure lives in an attachment. A spilled structure keeps its non-data fields and records the kind it had.",
            "required": ["attachment"],
            "properties": {
              "attachment": {"description": "id of an entry in attachments.", "type": "string"},
              "spilled_kind": {"enum": ["matrix", "table", "tree", "series", "object"]}
            }
          }
        }
      ]
    },
    "structure_or_list": {
      "anyOf": [
        {"$ref": "#/$defs/structure"},
        {"type": "array", "items": {"$ref": "#/$defs/structure"}}
      ]
    },
    "structures": {
      "type": "object",
      "properties": {
        "vcov": {
          "description": "One entry per vcov computed; the default one also feeds parameters.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/vcov"}
        },
        "fixed_effects": {
          "description": "One entry per FE. Counts only, never level values.",
          "type": "array",
          "items": {"$ref": "#/$defs/fixed_effect"}
        },
        "numerics": {"$ref": "#/$defs/numerics"},
        "random_effects": {"$ref": "#/$defs/structure_or_list"},
        "hyperparameters": {"$ref": "#/$defs/structure_or_list"},
        "first_stage": {"$ref": "#/$defs/structure_or_list"}
      },
      "additionalProperties": {"$ref": "#/$defs/structure_or_list"}
    },
    "vcov": {
      "allOf": [{"$ref": "#/$defs/structure"}],
      "properties": {
        "kind": {"enum": ["matrix", "link"]},
        "type": {"type": "string", "x-vocabulary": ["iid", "HC0", "HC1", "HC2", "HC3", "CRV1", "CRV3", "twoway", "multiway", "HAC", "DK"]},
        "cluster": {"$ref": "#/$defs/strings"},
        "n_clusters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}},
        "n_clusters_min": {"$ref": "#/$defs/count"},
        "ssc": {"$ref": "#/$defs/ssc"},
        "df_t": {"description": "df used for t tests and confidence intervals, in the tool's convention (e.g. G - 1 under clustering).", "$ref": "#/$defs/number_or_null"},
        "default": {"type": "boolean"}
      }
    },
    "ssc": {
      "description": "Small-sample correction written out in full. `convention` names what it reproduces (fixest, reghdfe, stata, linearmodels debiased=True, R lm, ...).",
      "type": "object",
      "properties": {
        "convention": {"type": "string"},
        "formula": {"type": "string"},
        "factors": {"description": "The individual factors, e.g. {\"G/(G-1)\": 1.0008, \"(N-1)/(N-K)\": 1.0001}, or the tool's own settings (fixest K.adj, K.fixef, G.adj, G.df, t.df; pyfixest k_adj, k_fixef, G_adj, G_df).", "type": "object"},
        "K_counts": {"description": "What K counted (regressors, absorbed levels, nested FEs).", "type": ["string", "object"]}
      }
    },
    "fixed_effect": {
      "allOf": [{"$ref": "#/$defs/structure"}],
      "properties": {
        "kind": {"const": "object"},
        "name": {"type": "string"},
        "components": {"description": "For interactions and slopes (reghdfe e(extended_absvars)).", "$ref": "#/$defs/strings"},
        "levels": {"description": "Levels in the estimation sample (fixest fixef_sizes, Stata e(kabsorb)).", "$ref": "#/$defs/count"},
        "levels_in_data": {"$ref": "#/$defs/count"},
        "redundant": {"$ref": "#/$defs/count"},
        "redundant_method": {"type": "string", "x-vocabulary": ["exact", "nested", "pairwise", "firstpair", "clusters", "continuous"]},
        "nested_in": {"$ref": "#/$defs/strings"},
        "singletons": {"description": "Singleton rows due to this FE (Stata e(ksingle)).", "$ref": "#/$defs/count"},
        "group_size": {
          "type": "object",
          "properties": {
            "min": {"$ref": "#/$defs/number"},
            "mean": {"$ref": "#/$defs/number"},
            "max": {"$ref": "#/$defs/number"}
          }
        },
        "constant_reported": {"description": "Whether the tool reports a constant row alongside this FE (reghdfe e(report_constant)).", "type": "boolean"}
      }
    },
    "numerics": {
      "allOf": [{"$ref": "#/$defs/structure"}],
      "properties": {
        "kind": {"const": "object"},
        "iterative": {"description": "Whether the algorithm is iterative.", "type": "boolean"},
        "algorithm": {"type": "string"},
        "acceleration": {"type": "string"},
        "transform": {"type": "string"},
        "preconditioner": {"type": "string"},
        "solver": {"type": "string"},
        "tolerance": {"$ref": "#/$defs/number_or_null"},
        "max_iterations": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
        "iterations": {"anyOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]},
        "converged": {"type": ["boolean", "null"]},
        "rank": {"$ref": "#/$defs/count"},
        "condition_number": {"$ref": "#/$defs/number_or_null"},
        "collinearity_tolerance": {"$ref": "#/$defs/number_or_null"},
        "collinear_terms": {"$ref": "#/$defs/strings"},
        "collinearity_min_norm": {"$ref": "#/$defs/number_or_null"},
        "orthogonality_check": {"$ref": "#/$defs/number_or_null"}
      }
    },

    "provenance": {
      "description": "How and where the run happened; open-ended, filled as far as the producer can.",
      "type": "object",
      "properties": {
        "software": {"type": "array", "items": {"$ref": "#/$defs/software_component"}},
        "environment": {"$ref": "#/$defs/environment"},
        "execution": {"$ref": "#/$defs/execution"},
        "agent": {
          "description": "Who ran it and where.",
          "x-identifying": true,
          "anyOf": [
            {"type": "object", "properties": {"user": {"type": "string"}, "host": {"type": "string"}}},
            {"$ref": "#/$defs/redacted"}
          ]
        },
        "data": {"type": "array", "items": {"$ref": "#/$defs/data_input"}}
      }
    },
    "software_component": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "purl": {
          "description": "Package URL, e.g. pkg:cran/fixest@0.14.2, pkg:pypi/numpy@2.1.0, pkg:github/jemather/dfeols@ce05eec, pkg:generic/stata@19.5.",
          "type": "string",
          "pattern": "^pkg:[a-z][a-z0-9.+-]*/"
        },
        "role": {"type": "string", "x-vocabulary": ["estimator", "language", "dependency", "system", "container"]},
        "source": {
          "description": "CRAN, PyPI, conda, SSC, or {git commit, dirty}.",
          "anyOf": [
            {"type": "string"},
            {"type": "object", "properties": {"repository": {"type": "string"}, "commit": {"type": "string"}, "dirty": {"type": "boolean"}}}
          ]
        },
        "hash": {"type": "string"},
        "attributes": {"type": "object"},
        "lock": {
          "description": "Pointer to a full lock file (renv.lock, pylock.toml, conda-lock.yml, CycloneDX SBOM).",
          "type": "object",
          "properties": {
            "format": {"type": "string", "x-vocabulary": ["renv.lock", "pylock.toml", "conda-lock", "cyclonedx", "spdx", "pip-freeze"]},
            "path": {"x-identifying": true, "type": "string"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "container": {
          "type": "object",
          "properties": {
            "image": {"type": "string"},
            "digest": {"type": "string"},
            "path": {"x-identifying": true, "type": "string"}
          }
        }
      }
    },
    "environment": {
      "description": "OS, hardware, numerical libraries, random numbers, allowlisted environment variables. Never a full environment dump.",
      "type": "object",
      "properties": {
        "os": {"type": "string"},
        "kernel": {"type": "string"},
        "locale": {"type": "string"},
        "timezone": {"type": "string"},
        "host": {"x-identifying": true, "type": "string"},
        "hostname": {"x-identifying": true, "type": "string"},
        "hardware": {
          "type": "object",
          "properties": {
            "cpu_model": {"type": "string"},
            "sockets": {"$ref": "#/$defs/count"},
            "cores": {"$ref": "#/$defs/count"},
            "threads": {"$ref": "#/$defs/count"},
            "cpu_flags": {"$ref": "#/$defs/strings"},
            "memory_bytes": {"$ref": "#/$defs/count"},
            "gpus": {"type": "array"}
          }
        },
        "blas": {"type": ["string", "object"]},
        "lapack": {"type": ["string", "object"]},
        "threadpools": {"description": "threadpoolctl.threadpool_info() entries, or the equivalent.", "type": "array", "items": {"type": "object"}},
        "random": {"description": "Generator type, seed, state (R RNGkind(), Stata c(rngtype), numpy bit generator).", "type": "object"},
        "variables": {"description": "Allowlisted environment variables only (OMP_NUM_THREADS, MKL_NUM_THREADS, POLARS_MAX_THREADS, ...).", "type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "started": {"$ref": "#/$defs/timestamp"},
        "finished": {"$ref": "#/$defs/timestamp"},
        "timezone": {"description": "Local zone of the run.", "type": "string"},
        "elapsed_seconds": {"$ref": "#/$defs/number"},
        "processor_seconds": {"$ref": "#/$defs/number"},
        "stages": {"description": "Timing by stage.", "type": ["object", "array"]},
        "peak_memory_bytes": {"$ref": "#/$defs/count"},
        "invocation": {
          "type": "object",
          "properties": {
            "command_line": {"x-identifying": true, "type": "string"},
            "argv": {"x-identifying": true, "anyOf": [{"$ref": "#/$defs/strings"}, {"$ref": "#/$defs/redacted"}]},
            "script_path": {"x-identifying": true, "type": "string"},
            "script_sha256": {"$ref": "#/$defs/sha256"},
            "working_directory": {"x-identifying": true, "type": "string"},
            "mode": {"type": "string", "x-vocabulary": ["interactive", "batch"]}
          }
        },
        "scheduler": {
          "description": "Scheduler data in the scheduler's own field names; SLURM uses sacct --format names. Other schedulers (PBS, LSF, SGE) use their own names under their own type.",
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"type": "string", "x-vocabulary": ["slurm", "pbs", "lsf", "sge"]},
            "JobID": {"x-identifying": true, "type": ["string", "integer"]},
            "JobName": {"x-identifying": true, "type": "string"},
            "Account": {"x-identifying": true, "type": "string"},
            "User": {"x-identifying": true, "type": "string"},
            "NodeList": {"x-identifying": true, "type": "string"},
            "SubmitLine": {"x-identifying": true, "type": "string"},
            "WorkDir": {"x-identifying": true, "type": "string"},
            "Partition": {"type": "string"},
            "QOS": {"type": "string"},
            "AllocCPUS": {"type": ["integer", "string"]},
            "AllocTRES": {"type": "string"},
            "ReqMem": {"type": "string"},
            "Submit": {"type": "string"},
            "Start": {"type": "string"},
            "End": {"type": "string"},
            "Elapsed": {"type": "string"},
            "MaxRSS": {"type": "string"},
            "State": {"type": "string"},
            "ExitCode": {"type": "string"}
          }
        },
        "workers": {
          "description": "One entry per worker, or a summary {count, cores, memory, peak}.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {"x-identifying": true, "type": "string"},
                  "cores": {"$ref": "#/$defs/count"},
                  "memory_bytes": {"$ref": "#/$defs/count"},
                  "peak_memory_bytes": {"$ref": "#/$defs/count"}
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "count": {"$ref": "#/$defs/count"},
                "cores": {"$ref": "#/$defs/count"},
                "memory_bytes": {"$ref": "#/$defs/count"},
                "peak_memory_bytes": {"$ref": "#/$defs/count"}
              }
            }
          ]
        },
        "launch": {"description": "Launch parameters, fully resolved.", "type": "object"},
        "session": {"description": "Session id, when the run came from a session.", "type": "string"}
      }
    },
    "data_input": {
      "type": "object",
      "properties": {
        "role": {"type": "string"},
        "name": {"type": "string"},
        "version": {"type": "string"},
        "location": {"x-identifying": true, "type": "string"},
        "checksum": {"$ref": "#/$defs/checksum"},
        "rows": {"$ref": "#/$defs/count"},
        "columns": {"anyOf": [{"$ref": "#/$defs/count"}, {"$ref": "#/$defs/strings"}]},
        "source": {"type": "string"},
        "license": {"type": "string"},
        "publication": {"$ref": "#/$defs/publication"}
      }
    },
    "checksum": {
      "description": "Two checksums are comparable only if algorithm, of and method match. In-memory content has no format-defined hash, so method is required for it.",
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"type": "string"},
        "value": {"type": "string"},
        "of": {"type": "string", "x-vocabulary": ["file", "manifest", "in-memory"]},
        "method": {"type": "string"}
      },
      "if": {"properties": {"of": {"const": "in-memory"}}, "required": ["of"]},
      "then": {"required": ["method"]}
    },

    "publication": {
      "type": "object",
      "properties": {
        "citation": {"$ref": "#/$defs/csl_item"},
        "locator": {"$ref": "#/$defs/locator"},
        "locators": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/locator"}},
        "status": {"enum": ["published", "accepted", "submitted", "working-paper", "preprint", "unpublished"]},
        "ascollected_url": {"type": ["string", "null"], "format": "uri"},
        "researchbox_url": {"type": ["string", "null"], "format": "uri"},
        "researchbox_files": {"type": "array", "items": {"type": "integer"}},
        "aspredicted_url": {"type": ["string", "null"], "format": "uri"},
        "replication_package": {
          "type": "object",
          "properties": {"doi": {"type": "string"}, "url": {"type": "string", "format": "uri"}}
        },
        "links": {
          "type": "array",
          "items": {"type": "object", "required": ["rel", "url"], "properties": {"rel": {"type": "string"}, "url": {"type": "string"}}}
        }
      },
      "not": {"required": ["locator", "locators"]}
    },
    "locator": {
      "description": "Where in the work: structured fields plus the label as printed.",
      "type": "object",
      "properties": {
        "study": {"type": ["string", "integer", "null"]},
        "table": {"type": ["string", "integer", "null"]},
        "panel": {"type": ["string", "integer", "null"]},
        "column": {"type": ["string", "integer", "null"]},
        "row": {"type": ["string", "integer", "null"]},
        "figure": {"type": ["string", "integer", "null"]},
        "equation": {"type": ["string", "integer", "null"]},
        "page": {"type": ["string", "integer", "null"]},
        "appendix": {"type": ["string", "integer", "null"]},
        "section": {"type": ["string", "integer", "null"]},
        "label": {"type": "string"}
      }
    },
    "csl_item": {
      "description": "A CSL-JSON item (citation-style-language/schema csl-data.json). CSL itself also requires `id`; this schema requires only `type`.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": {"type": ["string", "number"]},
        "type": {
          "enum": ["article", "article-journal", "article-magazine", "article-newspaper", "bill", "book", "broadcast", "chapter", "classic", "collection", "dataset", "document", "entry", "entry-dictionary", "entry-encyclopedia", "event", "figure", "graphic", "hearing", "interview", "legal_case", "legislation", "manuscript", "map", "motion_picture", "musical_score", "pamphlet", "paper-conference", "patent", "performance", "periodical", "personal_communication", "post", "post-weblog", "regulation", "report", "review", "review-book", "software", "song", "speech", "standard", "thesis", "treaty", "webpage"]
        },
        "title": {"type": "string"},
        "author": {"type": "array", "items": {"$ref": "#/$defs/csl_name"}},
        "editor": {"type": "array", "items": {"$ref": "#/$defs/csl_name"}},
        "issued": {"$ref": "#/$defs/csl_date"},
        "accessed": {"$ref": "#/$defs/csl_date"},
        "container-title": {"type": "string"},
        "volume": {"type": ["string", "number"]},
        "issue": {"type": ["string", "number"]},
        "page": {"type": ["string", "number"]},
        "number": {"type": ["string", "number"]},
        "publisher": {"type": "string"},
        "DOI": {"type": "string"},
        "URL": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "csl_name": {
      "type": "object",
      "properties": {
        "family": {"type": "string"},
        "given": {"type": "string"},
        "dropping-particle": {"type": "string"},
        "non-dropping-particle": {"type": "string"},
        "suffix": {"type": "string"},
        "comma-suffix": {"type": ["string", "number", "boolean"]},
        "static-ordering": {"type": ["string", "number", "boolean"]},
        "literal": {"type": "string"},
        "parse-names": {"type": ["string", "number", "boolean"]}
      },
      "additionalProperties": false
    },
    "csl_date": {
      "type": "object",
      "properties": {
        "date-parts": {"type": "array", "maxItems": 2, "items": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": ["string", "number"]}}},
        "season": {"type": ["string", "number"]},
        "circa": {"type": ["string", "number", "boolean"]},
        "literal": {"type": "string"},
        "raw": {"type": "string"}
      }
    },

    "validation": {
      "description": "Other software's version of this model and how close it came. Optional; expected for custom or untested estimators.",
      "type": "object",
      "properties": {
        "equivalents": {"type": "array", "items": {"$ref": "#/$defs/equivalent"}},
        "comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
        "verdict": {"type": "string", "x-vocabulary": ["pass", "fail", "mixed", "not_run"]}
      }
    },
    "equivalent": {
      "description": "The same model elsewhere, in an open set of styles; readers skip styles they don't know.",
      "type": "object",
      "required": ["style"],
      "properties": {
        "name": {"description": "How comparisons refer to it.", "type": "string"},
        "style": {"type": "string", "x-vocabulary": ["code", "description", "record", "published"]}
      },
      "allOf": [
        {
          "if": {"properties": {"style": {"const": "code"}}},
          "then": {"required": ["code"], "properties": {"software": {"type": "string"}, "language": {"type": "string"}, "code": {"type": "string"}}}
        },
        {
          "if": {"properties": {"style": {"const": "description"}}},
          "then": {"required": ["description"], "properties": {"description": {"type": "string"}}}
        },
        {
          "if": {"properties": {"style": {"const": "record"}}},
          "then": {
            "anyOf": [{"required": ["record"]}, {"required": ["path"]}, {"required": ["id"]}],
            "properties": {"record": {"type": "object"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "id": {"type": "string"}}
          }
        },
        {
          "if": {"properties": {"style": {"const": "published"}}},
          "then": {"required": ["publication", "values"], "properties": {"publication": {"$ref": "#/$defs/publication"}, "values": {"type": ["object", "array"]}}}
        }
      ]
    },
    "comparison": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": {"description": "name of an equivalent.", "type": "string"},
        "quantities": {"$ref": "#/$defs/strings"},
        "term_map": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerance": {"type": "object", "properties": {"rel": {"$ref": "#/$defs/number"}, "abs": {"$ref": "#/$defs/number"}}},
        "max_abs_diff": {"type": ["object", "number", "string"]},
        "max_rel_diff": {"type": ["object", "number", "string"]},
        "pass": {"type": ["boolean", "null"]},
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {"type": "string"},
              "quantity": {"type": "string"},
              "value": {"$ref": "#/$defs/number_or_null"},
              "reference": {"$ref": "#/$defs/number_or_null"},
              "diff": {"$ref": "#/$defs/number_or_null"}
            }
          }
        }
      }
    },

    "attachment": {
      "description": "A link to a side file. The record stays valid if the file is missing; the hash says whether a file found later is the right one.",
      "type": "object",
      "required": ["id", "path"],
      "x-expected": ["sha256"],
      "properties": {
        "id": {"type": "string"},
        "role": {"type": "string", "x-vocabulary": ["fe_coefficients", "residuals", "fitted_values", "predictions", "vcov", "sample_rows", "structure"]},
        "path": {"description": "Relative to the record, or a URI.", "type": "string"},
        "media_type": {"type": "string"},
        "created": {"$ref": "#/$defs/timestamp"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"$ref": "#/$defs/count"},
        "rows": {"$ref": "#/$defs/count"},
        "columns": {"$ref": "#/$defs/strings"}
      }
    },
    "extension": {
      "type": "object",
      "x-expected": ["schema", "by", "added"],
      "properties": {
        "schema": {"description": "The schema that validates this block, e.g. dfeols/0.1.", "type": "string"},
        "by": {"$ref": "#/$defs/tool"},
        "added": {"$ref": "#/$defs/timestamp"}
      }
    },
    "history_entry": {
      "type": "object",
      "x-expected": ["when", "by", "action"],
      "properties": {
        "when": {"$ref": "#/$defs/timestamp"},
        "by": {"$ref": "#/$defs/tool"},
        "action": {"type": "string", "x-vocabulary": ["created", "extended", "redacted", "validated"]},
        "sections": {"$ref": "#/$defs/strings"},
        "method": {"type": "string"},
        "fields": {"$ref": "#/$defs/strings"},
        "salt_id": {"type": "string"}
      }
    }
  }
}
