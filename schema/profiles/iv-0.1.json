{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jemather/dfeols/main/schema/profiles/iv-0.1.json",
  "title": "iv/0.1",
  "description": "Profile for instrumental-variables models: Stata ivregress, ivreg2, ivreghdfe; R fixest, ivreg, estimatr iv_robust, lfe; Python linearmodels, pyfixest; FixedEffectModels.jl (survey 2026-10-24 in docs/design/estimation-format.md). Requires inference/0.1 plus specification.endogenous and specification.instruments (excluded instruments), which every tool stores. structures.first_stage is expected, not required: most tools compute first-stage statistics only on request. A FE IV record also claims linear-fe/0.1.",
  "allOf": [
    {"$ref": "../estimation-0.1.json"},
    {"$ref": "#/$defs/rules"}
  ],
  "$defs": {
    "rules": {
      "allOf": [{"$ref": "inference-0.1.json#/$defs/rules"}],
      "type": "object",
      "required": ["specification"],
      "properties": {
        "specification": {
          "required": ["endogenous", "instruments"],
          "properties": {
            "endogenous": {"description": "Endogenous regressors.", "minItems": 1},
            "instruments": {"description": "Excluded instruments.", "minItems": 1}
          }
        },
        "metrics": {
          "properties": {
            "kappa": {"description": "k-class parameter (LIML lambda).", "x-tools": {"ivregress": "e(kappa)", "ivreg2": "e(lambda)", "linearmodels": "kappa"}},
            "fuller": {"description": "Fuller parameter.", "x-tools": {"ivreg2": "e(fuller)"}}
          }
        },
        "structures": {
          "x-expected": ["first_stage"],
          "properties": {
            "first_stage": {"$ref": "#/$defs/first_stage"}
          }
        }
      }
    },
    "test": {
      "description": "A test statistic. `name` says which test when the slot allows several (e.g. overid: sargan, basmann, score, hansen_j).",
      "type": "object",
      "required": ["statistic"],
      "properties": {
        "name": {"type": "string"},
        "statistic": {"$ref": "../estimation-0.1.json#/$defs/number_or_null"},
        "p_value": {"$ref": "../estimation-0.1.json#/$defs/number_or_null"},
        "df": {"$ref": "../estimation-0.1.json#/$defs/number_or_null"},
        "df1": {"$ref": "../estimation-0.1.json#/$defs/number_or_null"},
        "df2": {"$ref": "../estimation-0.1.json#/$defs/number_or_null"},
        "distribution": {"type": "string", "x-vocabulary": ["F", "chi2", "normal"]},
        "vcov": {"description": "vcov type the statistic uses, when it differs from the default vcov.", "type": "string"}
      }
    },
    "test_or_number": {
      "anyOf": [{"$ref": "#/$defs/test"}, {"$ref": "../estimation-0.1.json#/$defs/number_or_null"}]
    },
    "first_stage": {
      "description": "First-stage and identification diagnostics. Per-coefficient first-stage estimates go in parameters with component \"first_stage\" and response = the endogenous variable.",
      "allOf": [{"$ref": "../estimation-0.1.json#/$defs/structure"}],
      "properties": {
        "kind": {"enum": ["object", "link"]},
        "per_endogenous": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["endogenous"],
            "properties": {
              "endogenous": {"type": "string"},
              "f_stat": {
                "description": "First-stage F of the excluded instruments.",
                "$ref": "#/$defs/test_or_number",
                "x-tools": {"ivregress": "estat firststage r(singleresults) F", "ivreg2/ivreghdfe": "e(first) F", "fixest": "fitstat ivf1 (ivwald1 robust)", "ivreg": "summary diagnostics \"Weak instruments\"", "estimatr": "diagnostic_first_stage_fstatistic", "lfe": "stage1$iv1fstat / rob.iv1fstat", "linearmodels": "first_stage.diagnostics f.stat", "pyfixest": "_f_stat_1st_stage"}
              },
              "r2": {"$ref": "../estimation-0.1.json#/$defs/number_or_null", "x-tools": {"ivregress": "r(singleresults)", "linearmodels": "rsquared"}},
              "partial_r2": {"$ref": "../estimation-0.1.json#/$defs/number_or_null", "x-tools": {"ivregress": "r(singleresults)", "ivreg2/ivreghdfe": "e(first) pr2", "linearmodels": "partial.rsquared"}},
              "shea_partial_r2": {"$ref": "../estimation-0.1.json#/$defs/number_or_null", "x-tools": {"ivregress": "r(multiresults)", "ivreg2/ivreghdfe": "e(first) sheapr2", "linearmodels": "shea.rsquared"}},
              "sw_f": {"description": "Sanderson-Windmeijer conditional F.", "$ref": "#/$defs/test_or_number", "x-tools": {"ivreg2/ivreghdfe": "e(first) SWF, SWFdf1, SWFdf2, SWFp", "lfe": "condfstat()"}},
              "ap_f": {"description": "Angrist-Pischke conditional F.", "$ref": "#/$defs/test_or_number", "x-tools": {"ivreg2/ivreghdfe": "e(first) APF, APFdf1, APFdf2, APFp"}},
              "effective_f": {"description": "Montiel Olea-Pflueger effective F.", "$ref": "#/$defs/test_or_number", "x-tools": {"pyfixest": "_eff_F (IV_Diag)"}}
            }
          }
        },
        "underidentification": {"description": "Anderson LM (iid) or Kleibergen-Paap rk LM.", "$ref": "#/$defs/test", "x-tools": {"ivreg2/ivreghdfe": "e(idstat), e(idp), e(iddf)"}},
        "weak_id_cd_f": {"description": "Cragg-Donald Wald F.", "$ref": "#/$defs/test_or_number", "x-tools": {"ivregress": "estat firststage r(mineig)", "ivreg2/ivreghdfe": "e(cdf)", "fixest": "fitstat cd", "linearmodels": "first_stage.cragg_donald_f"}},
        "weak_id_kp_f": {"description": "Kleibergen-Paap rk Wald F.", "$ref": "#/$defs/test_or_number", "x-tools": {"ivreg2/ivreghdfe": "e(rkf)", "fixest": "fitstat kpr", "linearmodels": "first_stage.kleibergen_paap_f", "FixedEffectModels.jl": "F_kp, p_kp"}},
        "weak_id_robust_ar": {"description": "Anderson-Rubin test of the endogenous coefficients.", "$ref": "#/$defs/test", "x-tools": {"ivreg2/ivreghdfe": "e(arf), e(arfp) / e(archi2), e(archi2p)"}},
        "weak_id_robust_sw": {"description": "Stock-Wright LM S.", "$ref": "#/$defs/test", "x-tools": {"ivreg2/ivreghdfe": "e(sstat), e(sstatp), e(sstatdf)"}},
        "overid": {
          "type": "array",
          "items": {"$ref": "#/$defs/test"},
          "x-tools": {"ivregress": "estat overid (sargan, basmann, score; LIML ar; GMM HansenJ)", "ivreg2/ivreghdfe": "e(j), e(sargan)", "fixest": "iv_sargan", "ivreg": "summary diagnostics \"Sargan\"", "estimatr": "diagnostic_overid_test", "linearmodels": "sargan, basmann, basmann_f, wooldridge_overid"}
        },
        "endogeneity": {
          "type": "array",
          "items": {"$ref": "#/$defs/test"},
          "x-tools": {"ivregress": "estat endogenous (durbin, wu, r_score)", "ivreg2/ivreghdfe": "e(estat) with endog()", "fixest": "iv_wh", "ivreg": "summary diagnostics \"Wu-Hausman\"", "estimatr": "diagnostic_endogeneity_test", "linearmodels": "wu_hausman(), durbin(), wooldridge_score, wooldridge_regression"}
        }
      }
    }
  }
}
